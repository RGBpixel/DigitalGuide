{
  "name": "digitalguide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "setup:local": "tsx scripts/setup-local.ts",
    "setup:media": "node scripts/setup-media-tools.mjs",
    "setup:denoising": "tsx scripts/setup-denoising.ts",
    "setup:segmentation": "node scripts/setup-segmentation.mjs",
    "setup:semantic": "node --max-old-space-size=768 --import tsx scripts/setup-semantic.ts",
    "setup:restoration": "node --max-old-space-size=256 --import tsx scripts/setup-restoration.ts",
    "setup:gaze": "node --max-old-space-size=256 --import tsx scripts/setup-gaze.ts",
    "setup:editor": "node --max-old-space-size=256 --import tsx scripts/setup-editor.ts",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint apps packages tests scripts/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "build": "pnpm typecheck && node scripts/build.mjs",
    "build:course-player": "node scripts/build-course-player.mjs",
    "build:share-player": "node scripts/build-share-player.mjs",
    "start": "node dist/api.mjs",
    "start:worker": "node dist/worker.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "api:spec": "tsx scripts/export-openapi.ts",
    "recovery": "tsx scripts/recovery.ts",
    "postgres": "tsx scripts/postgres.ts",
    "setup:postgres-native": "node scripts/postgres-native-setup.mjs",
    "postgres:runtime": "tsx scripts/postgres-runtime.ts",
    "postgres:recovery": "tsx scripts/postgres-recovery.ts",
    "webhooks:dispatch": "tsx scripts/developer-webhooks.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@huggingface/tokenizers": "0.2.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "@napi-rs/canvas": "1.1.1",
    "@tanstack/react-query": "5.90.20",
    "fast-xml-parser": "5.12.1",
    "fastify": "5.12.8",
    "lucide-react": "0.468.0",
    "onnxruntime-web": "1.31.1",
    "openid-client": "6.9.1",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "playwright-core": "1.65.1",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "werift": "0.28.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "pdf-lib": "1.17.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
