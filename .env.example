APP_ENV=development
API_PORT=4300
WEB_PORT=5173
WEB_ORIGIN=http://127.0.0.1:5173
DATA_DIR=storage
DATABASE_DRIVER=sqlite
# 原生PostgreSQL核心验证使用独立目录和私有运行配置；完整业务迁移仍在进行。
POSTGRES_CORE_VALIDATION_ONLY=0
POSTGRES_RUNTIME_CONFIG=
# 原生模拟专注界面已完成本地GUI验证；默认无需预览标记，仍限私有验证实例。
NATIVE_SPEAKER_UI_PREVIEW=0
# 原生模拟单帧问答已完成分阶段GUI验证；默认无需预览标记，不表示真实视觉识别。
NATIVE_VISION_UI_PREVIEW=0
# 原生模拟餐中服务已完成GUI预览验证，默认开放；完整餐后与主动迎宾仍独立验收。
NATIVE_HOSPITALITY_UI_PREVIEW=0
# 原生mock餐后评价/独立回访已通过分阶段GUI，默认开放；完整主动接待继续独立验收。
NATIVE_AFTERCARE_UI_PREVIEW=0
PROVIDER_MODE=mock
# SESSION_SECRET is generated privately by setup:local. Never copy it to VITE_*.
SESSION_SECRET=
# Independent provenance signing key. Development persists storage/.provenance-secret.
# Production must supply this private server-side key; never use VITE_*.
CONTENT_PROVENANCE_SIGNING_KEY=
# Empty paths use the verified cache installed by pnpm setup:media.
# To use another trusted build, set both absolute server-side paths.
FFMPEG_PATH=
FFPROBE_PATH=
# Optional private server config for controlled AE rendering; never use a VITE_ variable.
AE_RUNTIME_CONFIG=

# 恢复副本只读验证：仅 development/sandbox + mock；不要启动 worker。
# RECOVERY_VALIDATION_ONLY=1

# 企业登录私有配置，仅服务端读取。默认不配置；真实身份源需要HTTPS和独立密钥文件。
ENTERPRISE_IDENTITY_CONFIG_FILE=

# Private SCIM configuration; bearer token files must stay outside DATA_DIR.
ENTERPRISE_DIRECTORY_CONFIG_FILE=

# 可选：DATA_DIR之外的回调接收端私有注册表；签名密钥不写入此文件。
DEVELOPER_WEBHOOKS_CONFIG_FILE=
