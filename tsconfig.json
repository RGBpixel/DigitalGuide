{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "baseUrl": ".", "paths": { "@digitalguide/*": ["packages/*/src/index.ts"] },
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["node", "vite/client"]
  },
  "include": ["apps", "packages", "scripts/*.ts", "tests", "playwright.config.ts", "vitest.config.ts"]
}
